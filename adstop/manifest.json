{
  "manifest_version": 3,
  "name": "AdStop – Bloqueur de pubs gratuit",
  "version": "1.1.0",
  "description": "Bloqueur de pubs gratuit et open source : pubs, pisteurs, popups, redirections, bannières cookies et pubs YouTube.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "webNavigation",
    "scripting",
    "activeTab",
    "declarativeNetRequestFeedback",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "easylist",
        "enabled": false,
        "path": "lists/easylist.json"
      },
      {
        "id": "easyprivacy",
        "enabled": false,
        "path": "lists/easyprivacy.json"
      },
      {
        "id": "antiadblock",
        "enabled": false,
        "path": "lists/antiadblock.json"
      },
      {
        "id": "cookies",
        "enabled": false,
        "path": "lists/cookies.json"
      },
      {
        "id": "annoyances",
        "enabled": false,
        "path": "lists/annoyances.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_isolated.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AdStop",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html"
}
